# GEMINI_API_KEY: Required for Gemini AI assistant features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Found in your Supabase project: Project Settings -> API
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Razorpay Payment Gateway Configuration
# Generated in Razorpay Dashboard: Settings -> API Keys (Use Test Mode for development)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

